<?xml version="1.0"?>
<!-- TurtleBot3 Lime

     Vendored from ROBOTIS-JAPAN-GIT/turtlebot3_lime @ humble-devel
     (commit 3363b27aae6d37598dc142cf4dddb342fef3047f), Apache-2.0.

     MODIFIED for the Isaac Sim 6.2 + ROS 2 Jazzy tutorials:
       * removed the Gazebo-classic includes and the gazebo_ros2_control plugin
         (Gazebo classic is not available on Jazzy; Isaac Sim is the simulator here)
       * removed the real-hardware ros2_control block; the simulation ros2_control
         block lives in turtlebot3_lime_moveit_config/config/lime_isaac.ros2_control.xacro
     The robot geometry (links, joints, meshes, inertias) is unchanged.
-->
<robot name="turtlebot3_lime"
  xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="prefix" default="" />

  <!-- Import materials macro -->
  <xacro:include filename="$(find turtlebot3_lime_description)/gazebo/materials.xacro" />

  <!-- Mobile base (TurtleBot3 big-wheel base + Jetson Orin + RealSense D435 + LDS) -->
  <xacro:include filename="$(find turtlebot3_lime_description)/urdf/turtlebot3_bigwheel_orin.urdf.xacro" />

  <!-- 6-DoF arm + gripper (OpenManipulator "SARA") -->
  <xacro:include filename="$(find turtlebot3_lime_description)/urdf/open_manipulator_sara.urdf.xacro" />

  <xacro:turtlebot3_bigwheel_orin prefix="$(arg prefix)" />

  <!-- Fixes the arm on top of the mobile base -->
  <joint name="$(arg prefix)base_fixed" type="fixed">
    <parent link="$(arg prefix)base_link"/>
    <child link="$(arg prefix)link1"/>
    <origin xyz="-0.036 0.0 0.07" rpy="0 0 0"/>
  </joint>

  <xacro:open_manipulator_sara prefix="$(arg prefix)" />

</robot>
