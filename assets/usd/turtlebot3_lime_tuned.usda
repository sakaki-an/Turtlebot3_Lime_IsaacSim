#usda 1.0
(
    defaultPrim = "turtlebot3_lime"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "turtlebot3_lime" (
    prepend references = @./turtlebot3_lime/turtlebot3_lime.usda@
    variants = {
        string Physics = "physx"
    }
)
{
    over "Physics"
    {
        over "wheel_left_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 1.7453293
            float drive:angular:physics:maxForce = 3
            float drive:angular:physics:stiffness = 0
            float drive:angular:physics:targetVelocity = 0
            uniform token drive:angular:physics:type = "force"
        }

        over "wheel_right_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 1.7453293
            float drive:angular:physics:maxForce = 3
            float drive:angular:physics:stiffness = 0
            float drive:angular:physics:targetVelocity = 0
            uniform token drive:angular:physics:type = "force"
        }

        over "joint1" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 0.17453292
            float drive:angular:physics:maxForce = 4.1
            float drive:angular:physics:stiffness = 3.4906585
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            float state:angular:physics:position = 0
        }

        over "joint2" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 0.17453292
            float drive:angular:physics:maxForce = 4.1
            float drive:angular:physics:stiffness = 3.4906585
            float drive:angular:physics:targetPosition = -63.025356
            uniform token drive:angular:physics:type = "force"
            float state:angular:physics:position = -63.025356
        }

        over "joint3" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 0.17453292
            float drive:angular:physics:maxForce = 4.1
            float drive:angular:physics:stiffness = 3.4906585
            float drive:angular:physics:targetPosition = 107.143105
            uniform token drive:angular:physics:type = "force"
            float state:angular:physics:position = 107.143105
        }

        over "joint4" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 0.17453292
            float drive:angular:physics:maxForce = 4.1
            float drive:angular:physics:stiffness = 3.4906585
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            float state:angular:physics:position = 0
        }

        over "joint5" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 0.17453292
            float drive:angular:physics:maxForce = 4.1
            float drive:angular:physics:stiffness = 3.4906585
            float drive:angular:physics:targetPosition = 56.149864
            uniform token drive:angular:physics:type = "force"
            float state:angular:physics:position = 56.149864
        }

        over "joint6" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 0.17453292
            float drive:angular:physics:maxForce = 4.1
            float drive:angular:physics:stiffness = 3.4906585
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            float state:angular:physics:position = 0
        }

        over "gripper_left_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:linear"]
        )
        {
            float drive:linear:physics:damping = 20
            float drive:linear:physics:maxForce = 10
            float drive:linear:physics:stiffness = 1000
            float drive:linear:physics:targetPosition = 0
            uniform token drive:linear:physics:type = "force"
            float state:linear:physics:position = 0
        }

        over "gripper_right_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:linear"]
        )
        {
            float drive:linear:physics:damping = 0
            float drive:linear:physics:maxForce = 10
            float drive:linear:physics:stiffness = 0
            float drive:linear:physics:targetVelocity = 0
            uniform token drive:linear:physics:type = "force"
        }
    }

    def "PhysicsMaterials"
    {
        def Material "wheel" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 1
            float physics:restitution = 0
            float physics:staticFriction = 1
            uniform token physxMaterial:frictionCombineMode = "average"
        }

        def Material "caster" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0
            float physics:restitution = 0
            float physics:staticFriction = 0
            uniform token physxMaterial:frictionCombineMode = "min"
        }
    }

    over "Geometry"
    {
        over "base_footprint"
        {
            over "base_link" (
                prepend apiSchemas = ["PhysxArticulationAPI"]
            )
            {
                int physxArticulation:solverPositionIterationCount = 64
                int physxArticulation:solverVelocityIterationCount = 16

                over "wheel_left_link"
                {
                    over "cylinder" (
                        prepend apiSchemas = ["MaterialBindingAPI"]
                    )
                    {
                        rel material:binding:physics = </turtlebot3_lime/PhysicsMaterials/wheel> (
                            bindMaterialAs = "weakerThanDescendants"
                        )
                    }
                }

                over "wheel_right_link"
                {
                    over "cylinder" (
                        prepend apiSchemas = ["MaterialBindingAPI"]
                    )
                    {
                        rel material:binding:physics = </turtlebot3_lime/PhysicsMaterials/wheel> (
                            bindMaterialAs = "weakerThanDescendants"
                        )
                    }
                }

                over "caster_back_left_link"
                {
                    over "box" (
                        prepend apiSchemas = ["MaterialBindingAPI"]
                    )
                    {
                        rel material:binding:physics = </turtlebot3_lime/PhysicsMaterials/caster> (
                            bindMaterialAs = "weakerThanDescendants"
                        )
                    }
                }

                over "caster_back_right_link"
                {
                    over "box" (
                        prepend apiSchemas = ["MaterialBindingAPI"]
                    )
                    {
                        rel material:binding:physics = </turtlebot3_lime/PhysicsMaterials/caster> (
                            bindMaterialAs = "weakerThanDescendants"
                        )
                    }
                }
            }
        }
    }
}

