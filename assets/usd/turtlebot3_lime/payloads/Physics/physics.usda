        def PhysicsPrismaticJoint "gripper_right_joint" (
            prepend apiSchemas = ["NewtonJointAPI", "NewtonMimicAPI", "PhysicsDriveAPI:linear", "PhysicsJointStateAPI:linear"]
        )
        {
            float drive:linear:physics:maxForce = 1
            float newton:damping = 0.7
            float newton:friction = 1
            rel newton:mimicJoint = </turtlebot3_lime/Physics/gripper_left_joint>
            float newton:velocityLimit = 4.8
            uniform token physics:axis = "Y"
            custom rel physics:body0
            append rel physics:body0 = </turtlebot3_lime/Geometry/base_footprint/base_link/link1/link2/link3/link4/link5/link6/link7>
            custom rel physics:body1
            append rel physics:body1 = </turtlebot3_lime/Geometry/base_footprint/base_link/link1/link2/link3/link4/link5/link6/link7/gripper_right_link>
            point3f physics:localPos0 = (0, -0.021, 0.0707)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0, -1, 0, 0)
            quatf physics:localRot1 = (0, -1, 0, 0)
            float physics:lowerLimit = -0.01
            float physics:upperLimit = 0.019
            custom float urdf:limit:effort = 1
        }

