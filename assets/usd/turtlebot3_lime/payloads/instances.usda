    def Xform "base" (
        prepend references = @./geometries.usd@</Geometries/base>
    )
    {
        over "base" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/base/VisualMaterials/light_black>
        }

        def Scope "VisualMaterials"
        {
            def Material "light_black" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/light_black>
            )
            {
            }
        }
    }

